{
  "name": "figma-canvas-writer-bridge",
  "version": "2.0.0",
  "description": "单客户端 MCP stdio 桥接服务，将经本地授权的工具调用转发给 Figma Design 插件。",
  "type": "module",
  "private": true,
  "main": "mcp-bridge.js",
  "scripts": {
    "build:crypto": "node ../scripts/build-crypto.mjs",
    "check:crypto": "node ../scripts/build-crypto.mjs --check",
    "check": "node --check mcp-bridge.js && node --check ../plugin/code.js && node --check ../install.mjs",
    "test": "node --test ../tests/bridge.protocol.test.mjs ../tests/ui.auth.test.mjs ../tests/ui.crypto.test.mjs ../tests/plugin.test.mjs ../tests/install.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "esbuild": "0.28.2"
  }
}
